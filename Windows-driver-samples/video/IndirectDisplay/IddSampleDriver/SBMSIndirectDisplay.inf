;
; SBMSIndirectDisplay.inf
;

[Version]
PnpLockDown=1
Signature="$Windows NT$"
ClassGUID = {4D36E968-E325-11CE-BFC1-08002BE10318}
Class = Display
ClassVer = 2.0
Provider=%ManufacturerName%
; build-sbms-driver.ps1 replaces this deterministic placeholder from root VERSION.
DriverVer=07/01/2026,0.0.0.0
CatalogFile=sbmsindirectdisplay.cat

[Manufacturer]
%ManufacturerName%=SBMS,NT$ARCH$.10.0...22000

[SBMS.NT$ARCH$.10.0...22000]
%DeviceName%=SBMS_Install, SBMS\IndirectDisplay
%DeviceName%=SBMS_Install, Root\SBMSIndirectDisplay

[SourceDisksFiles]
SBMSIndirectDisplay.dll=1

[SourceDisksNames]
1 = %DiskName%

; =================== UMDF Device ==================================

[SBMS_Install.NT]
Include=WUDFRD.inf
Needs=WUDFRD.NT
CopyFiles=UMDriverCopy

[SBMS_Install.NT.hw]
Include=WUDFRD.inf
Needs=WUDFRD.NT.HW
AddReg=SBMS_HardwareDeviceSettings

[SBMS_HardwareDeviceSettings]
HKR,, "UpperFilters", %REG_MULTI_SZ%, "IndirectKmd"
HKR, "WUDF", "DeviceGroupId", %REG_SZ%, "SBMSIndirectDisplayGroup"

[SBMS_Install.NT.Services]
Include=WUDFRD.inf
Needs=WUDFRD.NT.Services

[SBMS_Install.NT.Wdf]
UmdfService=SBMSIndirectDisplay,SBMSIndirectDisplay_Install
UmdfServiceOrder=SBMSIndirectDisplay
UmdfKernelModeClientPolicy=AllowKernelModeClients

[SBMSIndirectDisplay_Install]
UmdfLibraryVersion=$UMDFVERSION$
ServiceBinary=%12%\UMDF\SBMSIndirectDisplay.dll
UmdfExtensions=IddCx0102

[DestinationDirs]
UMDriverCopy=12,UMDF ; copy to drivers\umdf

[UMDriverCopy]
SBMSIndirectDisplay.dll

; =================== Generic ==================================

[Strings]
ManufacturerName="SBMS"
DiskName="SBMS Indirect Display Driver"
DeviceName="SBMS Virtual Display Adapter"

REG_MULTI_SZ  = 0x00010000
REG_SZ        = 0x00000000
