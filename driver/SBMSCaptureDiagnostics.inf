[Version]
Signature="$Windows NT$"
Class=Display
ClassGuid={4D36E968-E325-11CE-BFC1-08002BE10318}
ClassVer=2.0
Provider=%Provider%
DriverVer=11/16/2026,2.2.0.0
CatalogFile=SBMSCaptureDiagnostics.cat
PnpLockDown=1

[Manufacturer]
%Provider%=Models,NTamd64.10.0...19041

[Models.NTamd64.10.0...19041]
%DeviceName%=Install,SBMS\CaptureDiagnostics

[Install.NT]
Include=WUDFRD.inf
Needs=WUDFRD.NT
CopyFiles=DriverCopy

[Install.NT.HW]
Include=WUDFRD.inf
Needs=WUDFRD.NT.HW
AddReg=Hardware

[Hardware]
HKR,,"UpperFilters",0x00010000,"IndirectKmd"
HKR,"WUDF","DeviceGroupId",0x00000000,"SBMSCaptureDiagnostics"

[Install.NT.Services]
Include=WUDFRD.inf
Needs=WUDFRD.NT.Services

[Install.NT.Wdf]
UmdfService=SBMSCaptureDiagnostics,Service
UmdfServiceOrder=SBMSCaptureDiagnostics
UmdfKernelModeClientPolicy=AllowKernelModeClients

[Service]
UmdfLibraryVersion=2.25
ServiceBinary=%13%\SBMSCaptureDiagnostics.dll
UmdfExtensions=IddCx0102

[DestinationDirs]
DriverCopy=13

[DriverCopy]
SBMSCaptureDiagnostics.dll

[SourceDisksFiles]
SBMSCaptureDiagnostics.dll=1

[SourceDisksNames]
1=%DiskName%

[Strings]
Provider="SBMS"
DeviceName="SBMS Capture Diagnostics Display"
DiskName="SBMS Capture Diagnostics Driver"
