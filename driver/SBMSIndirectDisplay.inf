[Version]
Signature="$Windows NT$"
Class=Display
ClassGuid={4D36E968-E325-11CE-BFC1-08002BE10318}
ClassVer=2.0
Provider=%Provider%
DriverVer=07/26/2026,0.2.7.0
CatalogFile=SBMSIndirectDisplay.cat
PnpLockDown=1

[Manufacturer]
%Provider%=Models,NTamd64.10.0...19041

[Models.NTamd64.10.0...19041]
%DeviceName%=Install,SBMS\IndirectDisplay

[Install.NT]
Include=WUDFRD.inf
Needs=WUDFRD.NT
CopyFiles=DriverCopy

[Install.NT.HW]
Include=WUDFRD.inf
Needs=WUDFRD.NT.HW
AddReg=Hardware

[Hardware]
HKR,,"UpperFilters",0x00010000,"IndirectKmd"
HKR,"WUDF","DeviceGroupId",0x00000000,"SBMSIndirectDisplay"

[Install.NT.Services]
Include=WUDFRD.inf
Needs=WUDFRD.NT.Services

[Install.NT.Wdf]
UmdfService=SBMSIndirectDisplay,Service
UmdfServiceOrder=SBMSIndirectDisplay
UmdfKernelModeClientPolicy=AllowKernelModeClients

[Service]
UmdfLibraryVersion=2.25
ServiceBinary=%13%\SBMSIndirectDisplay.dll
UmdfExtensions=IddCx0102

[DestinationDirs]
DriverCopy=13

[DriverCopy]
SBMSIndirectDisplay.dll

[SourceDisksFiles]
SBMSIndirectDisplay.dll=1

[SourceDisksNames]
1=%DiskName%

[Strings]
Provider="SBMS"
DeviceName="SBMS Virtual Display"
DiskName="SBMS Driver"
