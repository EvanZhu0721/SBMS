import {
    Button,
    LineEdit,
    Palette,
    ProgressIndicator,
    ScrollView,
    TextEdit,
} from "std-widgets.slint";

// Material 3 semantic roles. Keeping colors behind roles makes the panel
// automatically follow the platform light/dark palette without styling
// individual controls ad hoc.
global MdTokens {
    out property <brush> surface: Palette.background;
    out property <brush> on-surface: Palette.foreground;
    out property <brush> surface-container: Palette.alternate-background;
    out property <brush> on-surface-variant: Palette.alternate-foreground;
    out property <brush> primary: Palette.accent-background;
    out property <brush> on-primary: Palette.accent-foreground;
    out property <brush> primary-container: Palette.color-scheme == ColorScheme.dark ? #4f378b : #eaddff;
    out property <brush> on-primary-container: Palette.color-scheme == ColorScheme.dark ? #eaddff : #21005d;
    out property <brush> error: Palette.color-scheme == ColorScheme.dark ? #ffb4ab : #ba1a1a;
    out property <brush> error-container: Palette.color-scheme == ColorScheme.dark ? #93000a : #ffdad6;
    out property <brush> on-error-container: Palette.color-scheme == ColorScheme.dark ? #ffdad6 : #410002;
    out property <brush> outline-variant: Palette.border;

    out property <length> space-1: 8px;
    out property <length> space-2: 16px;
    out property <length> shape-medium: 12px;
    out property <length> shape-large: 16px;
    out property <length> shape-full: 999px;
    out property <length> button-radius: 20px;
    out property <length> target: 48px;
    out property <length> type-title-large: 22px;
    out property <length> type-title-medium: 16px;
    out property <length> type-body-large: 16px;
    out property <length> type-body-medium: 14px;
    out property <length> type-body-small: 12px;
    out property <int> weight-medium: 500;
}

component ResolutionLineEdit inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder-text;
    in property <string> field-label;
    in property <string> suggestion;
    in property <string> suggestion-suffix;
    callback edited();

    height: MdTokens.target;
    background: transparent;
    clip: true;

    editor := LineEdit {
        width: parent.width;
        height: parent.height;
        text <=> root.text;
        placeholder-text: root.placeholder-text;
        input-type: InputType.number;
        font-size: MdTokens.type-body-large;
        accessible-label: root.field-label;
        accessible-description: root.suggestion == ""
            ? ""
            : "Suggested " + root.suggestion + ". Press Tab to accept.";
        edited => { root.edited(); }
        key-pressed(event) => {
            if event.text == Key.Tab && root.suggestion != "" {
                root.text = root.suggestion;
                root.edited();
            }
            // Let Tab keep its normal focus-navigation behavior.
            return reject;
        }
    }

    prefix-measure := Text {
        x: 16px;
        width: self.preferred-width;
        height: parent.height;
        text: root.text;
        color: transparent;
        font-size: MdTokens.type-body-large;
        vertical-alignment: center;
        accessible-role: none;
    }

    if editor.has-focus && root.suggestion-suffix != "" : Text {
        x: 16px + prefix-measure.preferred-width;
        width: parent.width - self.x - 40px;
        height: parent.height;
        text: root.suggestion-suffix;
        color: MdTokens.on-surface-variant;
        opacity: 0.55;
        font-size: MdTokens.type-body-large;
        vertical-alignment: center;
        overflow: clip;
        accessible-role: none;
    }
}

component CompactComboBox inherits Rectangle {
    in property <[string]> model;
    in property <[string]> collapsed-model: root.model;
    in-out property <int> current-index: -1;
    in property <bool> control-enabled: true;
    in property <string> field-label;
    in property <length> popup-width: root.width;
    callback selected();

    property <string> current-value: root.current-index >= 0
        && root.current-index < root.collapsed-model.length
        ? root.collapsed-model[root.current-index]
        : "";
    property <length> popup-height: root.model.length * MdTokens.target + 8px;

    height: MdTokens.target;
    background: selector-touch.pressed
        ? MdTokens.surface-container
        : (selector-touch.has-hover ? MdTokens.surface-container : MdTokens.surface);
    border-width: combo-focus.has-focus || popup.is-open ? 2px : 1px;
    border-color: combo-focus.has-focus || popup.is-open
        ? MdTokens.primary
        : MdTokens.outline-variant;
    border-radius: MdTokens.space-1;
    opacity: root.control-enabled ? 1 : 0.38;
    forward-focus: combo-focus;

    accessible-role: combobox;
    accessible-label: root.field-label;
    accessible-value: root.current-value;
    accessible-enabled: root.control-enabled;
    accessible-expandable: true;
    accessible-expanded: popup.is-open;
    accessible-action-expand => {
        if root.control-enabled && root.model.length > 0 {
            popup.show();
        }
    }

    Text {
        x: MdTokens.space-2;
        width: parent.width - 52px;
        height: parent.height;
        text: root.current-value;
        color: MdTokens.on-surface;
        font-size: MdTokens.type-body-large;
        vertical-alignment: center;
        overflow: clip;
        accessible-role: none;
    }

    Path {
        x: parent.width - 36px;
        y: 12px;
        width: 24px;
        height: 24px;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: "M7 9.5L12 14.5L17 9.5";
        fill: transparent;
        stroke: MdTokens.on-surface;
        stroke-width: 2.5px;
        accessible-role: none;
    }

    combo-focus := FocusScope {
        key-pressed(event) => {
            if !root.control-enabled || root.model.length == 0 {
                return reject;
            }
            if event.text == Key.UpArrow {
                root.current-index = Math.max(root.current-index - 1, 0);
                root.selected();
                return accept;
            } else if event.text == Key.DownArrow {
                root.current-index = Math.min(root.current-index + 1, root.model.length - 1);
                root.selected();
                return accept;
            } else if event.text == Key.Return {
                popup.show();
                return accept;
            }
            return reject;
        }

        selector-touch := TouchArea {
            enabled: root.control-enabled && root.model.length > 0;
            clicked => {
                root.focus();
                popup.show();
            }
        }
    }

    popup := PopupWindow {
        x: 0;
        y: -root.popup-height - 4px;
        width: root.popup-width;
        height: root.popup-height;
        close-policy: close-on-click-outside;
        forward-focus: popup-focus;

        popup-focus := FocusScope {
            key-pressed(event) => {
                if event.text == Key.UpArrow {
                    root.current-index = Math.max(root.current-index - 1, 0);
                    root.selected();
                    return accept;
                } else if event.text == Key.DownArrow {
                    root.current-index = Math.min(root.current-index + 1, root.model.length - 1);
                    root.selected();
                    return accept;
                } else if event.text == Key.Return || event.text == Key.Escape {
                    popup.close();
                    return accept;
                }
                return reject;
            }

            Rectangle {
                background: MdTokens.surface;
                border-width: 1px;
                border-color: MdTokens.outline-variant;
                border-radius: MdTokens.shape-medium;
                clip: true;

                VerticalLayout {
                    padding: 4px;
                    spacing: 0px;

                    for option[index] in root.model : Rectangle {
                        height: MdTokens.target;
                        border-radius: MdTokens.space-1;
                        background: index == root.current-index
                            ? MdTokens.primary-container
                            : (option-touch.has-hover ? MdTokens.surface-container : transparent);

                        Text {
                            x: MdTokens.space-2;
                            width: parent.width - 2 * MdTokens.space-2;
                            height: parent.height;
                            text: option;
                            color: index == root.current-index
                                ? MdTokens.on-primary-container
                                : MdTokens.on-surface;
                            font-size: MdTokens.type-body-large;
                            vertical-alignment: center;
                            overflow: clip;
                            accessible-role: none;
                        }

                        option-touch := TouchArea {
                            clicked => {
                                root.current-index = index;
                                root.selected();
                                popup.close();
                            }
                        }
                    }
                }
            }
        }
    }

    animate background { duration: 120ms; easing: ease-in-out; }
}

// Text buttons use three deliberate width tiers. This keeps their geometry
// stable when labels or translations change.
component BackButton inherits Button {
    text: "Back";
    width: 80px;
    height: MdTokens.target;
}

component PageActionButton inherits Button {
    width: 96px;
    height: MdTokens.target;
}

component FullWidthPrimaryButton inherits Button {
    height: MdTokens.target;
    primary: true;
}

// Dialog actions share one geometry and state-layer implementation.
// Only the semantic color role changes for destructive actions.
component DialogActionButton inherits Rectangle {
    in property <string> text;
    in property <string> field-label;
    in property <bool> destructive: false;
    callback clicked();

    width: 96px;
    height: MdTokens.target;
    background: root.destructive ? MdTokens.error-container : MdTokens.surface-container;
    border-radius: MdTokens.button-radius;

    Rectangle {
        width: parent.width;
        height: parent.height;
        border-radius: parent.border-radius;
        background: root.destructive ? MdTokens.on-error-container : MdTokens.on-surface;
        opacity: action-touch.pressed ? 0.12 : (action-touch.has-hover ? 0.08 : 0);
        animate opacity { duration: 100ms; easing: ease-in-out; }
    }

    Text {
        width: parent.width;
        height: parent.height;
        text: root.text;
        color: root.destructive ? MdTokens.on-error-container : MdTokens.on-surface;
        font-size: MdTokens.type-body-medium;
        font-weight: MdTokens.weight-medium;
        horizontal-alignment: center;
        vertical-alignment: center;
        accessible-role: none;
    }

    action-touch := TouchArea {
        accessible-role: button;
        accessible-label: root.field-label;
        clicked => { root.clicked(); }
    }
}

// A single geometry owns the container, state layer, icon and hit target.
// This avoids the text baseline and native button padding shifting small icons.
component MaterialIconButton inherits Rectangle {
    in property <int> icon-kind; // 0 add, 1 refresh, 2 tune, 3 settings, 4 more, 5 calculate
    in property <bool> compact: false;
    in property <bool> control-enabled: true;
    in property <string> field-label;
    callback clicked();

    width: root.compact ? 40px : MdTokens.target;
    height: root.compact ? 40px : MdTokens.target;
    background: MdTokens.surface-container;
    border-width: 1px;
    border-color: MdTokens.outline-variant;
    border-radius: MdTokens.shape-medium;
    opacity: root.control-enabled ? 1 : 0.38;

    // Material state layer. It deliberately shares the exact outer geometry.
    Rectangle {
        width: parent.width;
        height: parent.height;
        border-radius: root.border-radius;
        background: MdTokens.primary;
        opacity: icon-touch.pressed ? 0.12 : (icon-touch.has-hover ? 0.08 : 0);
        animate opacity { duration: 100ms; easing: ease-in-out; }
    }

    if root.icon-kind == 0 : Path {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 20px;
        height: 20px;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: "M19 13H13V19H11V13H5V11H11V5H13V11H19V13Z";
        fill: MdTokens.on-surface;
        accessible-role: none;
    }

    if root.icon-kind == 1 : Path {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 22px;
        height: 22px;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: "M17.65 6.35C16.2 4.9 14.21 4 12 4C7.58 4 4.01 7.58 4.01 12C4.01 16.42 7.58 20 12 20C15.73 20 18.84 17.45 19.73 14H17.65C16.83 16.33 14.61 18 12 18C8.69 18 6 15.31 6 12C6 8.69 8.69 6 12 6C13.66 6 15.14 6.69 16.22 7.78L13 11H20V4L17.65 6.35Z";
        fill: MdTokens.on-surface;
        accessible-role: none;
    }

    if root.icon-kind == 2 : Path {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 22px;
        height: 22px;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: "M3 17V19H9V17H3ZM3 5V7H13V5H3ZM13 21V19H21V17H13V15H11V21H13ZM7 9V11H3V13H7V15H9V9H7ZM21 13V11H11V13H21ZM15 9H17V7H21V5H17V3H15V9Z";
        fill: MdTokens.on-surface;
        accessible-role: none;
    }

    if root.icon-kind == 3 : Path {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 22px;
        height: 22px;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: "M19.43 12.98C19.47 12.66 19.5 12.34 19.5 12C19.5 11.66 19.47 11.34 19.42 11.02L21.54 9.37L19.54 5.91L17.04 6.92C16.54 6.52 16 6.18 15.4 5.93L15 3.27H11L10.6 5.93C10 6.18 9.45 6.53 8.96 6.92L6.46 5.91L4.46 9.37L6.58 11.02C6.53 11.34 6.5 11.67 6.5 12C6.5 12.33 6.53 12.66 6.58 12.98L4.46 14.63L6.46 18.09L8.96 17.08C9.45 17.47 10 17.82 10.6 18.07L11 20.73H15L15.4 18.07C16 17.82 16.54 17.48 17.04 17.08L19.54 18.09L21.54 14.63L19.43 12.98ZM13 15.5C11.07 15.5 9.5 13.93 9.5 12C9.5 10.07 11.07 8.5 13 8.5C14.93 8.5 16.5 10.07 16.5 12C16.5 13.93 14.93 15.5 13 15.5Z";
        fill: MdTokens.on-surface;
        accessible-role: none;
    }

    if root.icon-kind == 4 : Path {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 22px;
        height: 22px;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: "M6 10C4.9 10 4 10.9 4 12C4 13.1 4.9 14 6 14C7.1 14 8 13.1 8 12C8 10.9 7.1 10 6 10ZM12 10C10.9 10 10 10.9 10 12C10 13.1 10.9 14 12 14C13.1 14 14 13.1 14 12C14 10.9 13.1 10 12 10ZM18 10C16.9 10 16 10.9 16 12C16 13.1 16.9 14 18 14C19.1 14 20 13.1 20 12C20 10.9 19.1 10 18 10Z";
        fill: MdTokens.on-surface;
        accessible-role: none;
    }

    if root.icon-kind == 5 : Path {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 22px;
        height: 22px;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: "M19 3H5C3.9 3 3 3.9 3 5V19C3 20.1 3.9 21 5 21H19C20.1 21 21 20.1 21 19V5C21 3.9 20.1 3 19 3ZM19 19H5V5H19V19ZM7 7H17V11H7V7ZM7 13H9V15H7V13ZM11 13H13V15H11V13ZM15 13H17V15H15V13ZM7 17H9V19H7V17ZM11 17H13V19H11V17ZM15 17H17V19H15V17Z";
        fill: MdTokens.on-surface;
        accessible-role: none;
    }

    icon-touch := TouchArea {
        enabled: root.control-enabled;
        accessible-role: button;
        accessible-label: root.field-label;
        clicked => { root.clicked(); }
    }
}

component SegmentGlyph inherits Rectangle {
    in property <int> glyph;
    in property <brush> lit-color;
    property <brush> dim-color: transparent;

    width: 14px;
    height: 24px;
    background: transparent;

    // Segment order: a, b, c, d, e, f, g.
    Rectangle {
        x: 2px; y: 0px; width: 10px; height: 2px;
        background: root.glyph == 0 || root.glyph == 2 || root.glyph == 3
            || root.glyph == 5 || root.glyph == 6 || root.glyph == 7
            || root.glyph == 8 || root.glyph == 9 || root.glyph == 10
            || root.glyph == 14
            ? root.lit-color : root.dim-color;
    }
    Rectangle {
        x: 12px; y: 2px; width: 2px; height: 9px;
        background: root.glyph == 0 || root.glyph == 1 || root.glyph == 2
            || root.glyph == 3 || root.glyph == 4 || root.glyph == 7
            || root.glyph == 8 || root.glyph == 9 || root.glyph == 14
            ? root.lit-color : root.dim-color;
    }
    Rectangle {
        x: 12px; y: 13px; width: 2px; height: 9px;
        background: root.glyph == 0 || root.glyph == 1 || root.glyph == 3
            || root.glyph == 4 || root.glyph == 5 || root.glyph == 6
            || root.glyph == 7 || root.glyph == 8 || root.glyph == 9
            || root.glyph == 13 || root.glyph == 14
            ? root.lit-color : root.dim-color;
    }
    Rectangle {
        x: 2px; y: 22px; width: 10px; height: 2px;
        background: root.glyph == 0 || root.glyph == 2 || root.glyph == 3
            || root.glyph == 5 || root.glyph == 6 || root.glyph == 8
            || root.glyph == 9 || root.glyph == 10
            ? root.lit-color : root.dim-color;
    }
    Rectangle {
        x: 0px; y: 13px; width: 2px; height: 9px;
        background: root.glyph == 0 || root.glyph == 2 || root.glyph == 6
            || root.glyph == 8 || root.glyph == 10 || root.glyph == 11
            || root.glyph == 13 || root.glyph == 14
            ? root.lit-color : root.dim-color;
    }
    Rectangle {
        x: 0px; y: 2px; width: 2px; height: 9px;
        background: root.glyph == 0 || root.glyph == 4 || root.glyph == 5
            || root.glyph == 6 || root.glyph == 8 || root.glyph == 9
            || root.glyph == 10 || root.glyph == 14
            ? root.lit-color : root.dim-color;
    }
    Rectangle {
        x: 2px; y: 11px; width: 10px; height: 2px;
        background: root.glyph == 2 || root.glyph == 3 || root.glyph == 4
            || root.glyph == 5 || root.glyph == 6 || root.glyph == 8
            || root.glyph == 9 || root.glyph == 10 || root.glyph == 11
            || root.glyph == 12 || root.glyph == 13 || root.glyph == 14
            ? root.lit-color : root.dim-color;
    }
}

component SevenSegmentDisplay inherits Rectangle {
    in property <int> fps;
    in property <bool> valid;
    in property <bool> running;
    in property <bool> error;
    in property <bool> not-a-number;
    property <int> clamped-fps: Math.min(Math.max(root.fps, 0), 999);
    property <brush> segment-color: root.error ? MdTokens.error : MdTokens.primary;

    width: 76px;
    height: 36px;
    background: transparent;
    accessible-role: text;
    accessible-label: root.error
        ? "Mapping error"
        : (root.not-a-number ? "Stream only output has no local frame rate"
        : (root.running && root.valid
            ? "Mapping frame rate " + root.clamped-fps + " frames per second"
            : "Mapping frame rate unavailable"));

    HorizontalLayout {
        padding-left: 9px;
        padding-right: 9px;
        padding-top: 6px;
        padding-bottom: 6px;
        spacing: 4px;
        alignment: center;

        SegmentGlyph {
            glyph: root.error ? 10
                : (root.not-a-number ? 13
                : (root.running && root.valid
                    ? Math.mod(Math.floor(root.clamped-fps / 100), 10) : 12));
            lit-color: root.segment-color;
        }
        SegmentGlyph {
            glyph: root.error ? 11
                : (root.not-a-number ? 14
                : (root.running && root.valid
                    ? Math.mod(Math.floor(root.clamped-fps / 10), 10) : 12));
            lit-color: root.segment-color;
        }
        SegmentGlyph {
            glyph: root.error ? 11
                : (root.not-a-number ? 13
                : (root.running && root.valid ? Math.mod(root.clamped-fps, 10) : 12));
            lit-color: root.segment-color;
        }
    }
}

export component QuickAccess inherits Window {
    title: "SBMS Quick Access";
    width: 384px;
    height: 544px;
    background: MdTokens.surface;
    always-on-top: true;
    no-frame: true;

    in-out property <[string]> display-names;
    in-out property <[string]> display-labels;
    in-out property <[string]> display-ids;
    in-out property <[int]> display-widths;
    in-out property <[int]> display-heights;
    in-out property <int> selected-display: -1;
    in property <bool> stream-only: false;
    in-out property <[string]> tab-labels;
    in-out property <[string]> tab-details;
    in-out property <[int]> tab-indices;
    in property <int> active-group-index: 0;
    in property <int> group-count: 1;
    in property <int> max-group-count: 1;
    in-out property <int> pending-remove-index: -1;
    in-out property <[string]> reference-names;
    in-out property <[string]> reference-labels;
    in-out property <[string]> reference-ids;
    in-out property <int> selected-reference: -1;
    in property <bool> reference-manual: false;
    in property <bool> reference-action-enabled: false;
    in-out property <int> sizing-strategy: 0;
    in property <string> state: "Stopped";
    in property <string> state-detail: "Choose a target screen to begin";
    in property <bool> running: false;
    in property <bool> busy: false;
    in property <string> error-text: "";
    in property <int> mapping-fps: 0;
    in property <bool> mapping-fps-valid: false;
    in property <bool> mapping-fps-error: false;
    in property <bool> mapping-fps-nan: false;
    in-out property <bool> geometry-page: false;
    in-out property <bool> stream-page: false;
    in-out property <bool> screen-size-page: false;
    in-out property <bool> diagnostics-page: false;
    in property <string> screen-size-target: "";
    in property <string> screen-size-native-mode: "";
    in property <string> screen-size-detected-mm: "Not reported";
    in property <string> screen-size-detected-inches: "";
    in-out property <string> screen-size-manual-inches: "";
    in-out property <int> screen-size-aspect-ratio: 0;
    in property <string> screen-size-effective-mm: "";
    in property <string> screen-size-effective-inches: "";
    in property <string> screen-size-source: "";
    in property <string> screen-size-error: "";
    in property <bool> screen-size-valid: true;
    in property <bool> screen-size-save-blocked: false;
    in property <string> diagnostic-summary: "";
    in property <string> diagnostic-text: "No diagnostic records are available.";
    in property <string> diagnostic-path: "";
    in property <string> diagnostic-action-error: "";
    in property <bool> geometry-valid: false;
    in property <bool> geometry-save-blocked: false;
    in property <bool> geometry-configured: false;
    in property <string> geometry-summary: "3840 × 2160";
    in property <string> geometry-summary-detail: "Driver · 240 Hz";
    in property <string> geometry-result: "Enter display measurements";
    in property <string> geometry-result-detail: "All values use pixels or millimetres";
    in property <string> geometry-error: "";
    in-out property <string> reference-width: "";
    in-out property <string> reference-height: "";
    in-out property <string> reference-diagonal: "";
    in-out property <int> reference-aspect-ratio: 0;
    in-out property <int> reference-rotation: 0;
    in property <string> reference-width-suggestion: "";
    in property <string> reference-width-suffix: "";
    in property <string> reference-height-suggestion: "";
    in property <string> reference-height-suffix: "";
    in-out property <string> stream-width: "3840";
    in-out property <string> stream-height: "2160";
    in-out property <string> stream-diagonal: "";
    in-out property <string> stream-refresh: "60";
    in-out property <int> stream-aspect-ratio-index: 1;
    in-out property <int> stream-rotation: 0;
    in property <string> stream-width-suggestion: "";
    in property <string> stream-width-suffix: "";
    in property <string> stream-height-suggestion: "";
    in property <string> stream-height-suffix: "";
    in property <string> stream-aspect-ratio: "";
    in property <string> stream-result: "Configure the streaming screen";
    in property <string> stream-result-detail: "Reference geometry determines the virtual mode";
    in property <string> stream-error: "";
    in property <bool> sunshine-panel-enabled: false;
    // Sunshine deployment state: 0 unavailable, 1 starting, 2 ready, 3 failed.
    in property <int> sunshine-state: 0;
    in property <int> sunshine-port: 0;
    in property <string> sunshine-lan-ip: "--";

    callback start();
    callback stop();
    callback refresh();
    callback display-selected();
    callback reference-selected();
    callback strategy-selected();
    callback calculate-geometry();
    callback open-manual-geometry();
    callback dismiss();
    callback close-geometry();
    callback geometry-edited();
    callback save-geometry();
    callback open-diagnostics();
    callback close-diagnostics();
    callback open-log-folder();
    callback tab-selected(int);
    callback tab-wheel(int);
    callback add-group();
    callback remove-group(int);
    callback open-stream-config();
    callback close-stream-config();
    callback stream-edited();
    callback save-stream-config();
    callback open-sunshine-panel();
    callback open-screen-size();
    callback close-screen-size();
    callback screen-size-edited();
    callback reset-screen-size();
    callback reread-screen-size();
    callback save-screen-size();

    if !root.geometry-page && !root.stream-page && !root.screen-size-page && !root.diagnostics-page : FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.dismiss();
                return accept;
            }
            return reject;
        }

        Rectangle {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            background: MdTokens.surface;

            VerticalLayout {
                padding: MdTokens.space-2;
                spacing: MdTokens.space-1;

                HorizontalLayout {
                    height: 40px;
                    spacing: MdTokens.space-1;

                    tabs-viewport := Rectangle {
                        width: root.tab-labels.length * 96px
                            + Math.max(root.tab-labels.length - 1, 0) * 4px;
                        clip: true;
                        background: transparent;

                        HorizontalLayout {
                            spacing: 4px;

                            for tab[index] in root.tab-labels : Rectangle {
                                width: 96px;
                                background: root.tab-indices[index] == root.active-group-index
                                    ? MdTokens.primary-container
                                    : MdTokens.surface-container;
                                border-radius: 12px;

                                tab-touch := TouchArea {
                                    enabled: !root.busy;
                                    accessible-role: button;
                                    accessible-label: "Open mapping group " + tab + ", " + root.tab-details[index];
                                    clicked => { root.tab-selected(root.tab-indices[index]); }
                                    scroll-event(event) => {
                                        if event.delta-y < -1px || event.delta-x < -1px {
                                            root.tab-wheel(1);
                                            return accept;
                                        }
                                        if event.delta-y > 1px || event.delta-x > 1px {
                                            root.tab-wheel(-1);
                                            return accept;
                                        }
                                        return reject;
                                    }
                                }

                                Rectangle {
                                    x: 4px;
                                    y: 6px;
                                    width: 28px;
                                    height: 28px;
                                    border-radius: 10px;
                                    background: MdTokens.primary;

                                    Text {
                                        width: parent.width;
                                        height: parent.height;
                                        text: tab;
                                        color: MdTokens.on-primary;
                                        font-family: "Bahnschrift";
                                        font-size: 16px;
                                        font-weight: 600;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        accessible-role: none;
                                    }
                                }

                                Text {
                                    x: 36px;
                                    width: 30px;
                                    height: parent.height;
                                    color: root.tab-indices[index] == root.active-group-index
                                        ? MdTokens.on-primary-container
                                        : MdTokens.on-surface-variant;
                                    font-family: "Bahnschrift";
                                    font-size: 11px;
                                    font-weight: 600;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    text: root.tab-details[index];
                                    overflow: elide;
                                    accessible-role: none;
                                }

                                Rectangle {
                                    x: 68px;
                                    y: 0px;
                                    width: 28px;
                                    height: parent.height;
                                    background: transparent;
                                    opacity: root.group-count <= 1 ? 0
                                        : (!root.running && !root.busy ? 1 : 0.38);

                                    Rectangle {
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        width: 28px;
                                        height: 28px;
                                        border-radius: MdTokens.shape-full;
                                        background: root.tab-indices[index] == root.active-group-index
                                            ? MdTokens.on-primary-container : MdTokens.on-surface-variant;
                                        opacity: close-touch.pressed
                                            ? 0.12 : (close-touch.has-hover ? 0.08 : 0);
                                        animate opacity { duration: 100ms; easing: ease-in-out; }
                                    }

                                    Path {
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        width: 18px;
                                        height: 18px;
                                        viewbox-width: 24;
                                        viewbox-height: 24;
                                        commands: "M18.3 5.71L12 12L5.7 5.71L4.29 7.12L10.59 13.41L4.29 19.71L5.7 21.12L12 14.83L18.3 21.12L19.71 19.71L13.41 13.41L19.71 7.12L18.3 5.71Z";
                                        fill: root.tab-indices[index] == root.active-group-index
                                            ? MdTokens.on-primary-container : MdTokens.on-surface-variant;
                                        accessible-role: none;
                                    }

                                    close-touch := TouchArea {
                                        enabled: root.group-count > 1 && !root.running && !root.busy;
                                        accessible-role: button;
                                        accessible-label: "Remove mapping group " + tab;
                                        clicked => {
                                            if root.group-count > 1 {
                                                root.pending-remove-index = root.tab-indices[index];
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    MaterialIconButton {
                        icon-kind: 0;
                        compact: true;
                        control-enabled: !root.running && !root.busy && root.group-count < root.max-group-count;
                        field-label: "Add mapping group";
                        clicked => { root.add-group(); }
                    }

                    Rectangle { horizontal-stretch: 1; }
                }

                HorizontalLayout {
                    height: MdTokens.target;
                    spacing: MdTokens.space-1;

                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        spacing: 2px;
                        Text {
                            text: "SBMS";
                            color: MdTokens.on-surface;
                            font-size: MdTokens.type-title-large;
                            font-weight: MdTokens.weight-medium;
                        }
                        Text {
                            text: "Display mapping";
                            color: MdTokens.on-surface-variant;
                            font-size: MdTokens.type-body-small;
                        }
                    }

                    SevenSegmentDisplay {
                        fps: root.mapping-fps;
                        valid: root.mapping-fps-valid;
                        running: root.running;
                        error: root.mapping-fps-error;
                        not-a-number: root.mapping-fps-nan;
                    }
                }

                Rectangle {
                    height: root.error-text != "" ? 80px : 64px;
                    background: root.error-text != ""
                        ? MdTokens.error-container
                        : (root.running ? MdTokens.primary-container : MdTokens.surface-container);
                    border-radius: MdTokens.shape-medium;

                    HorizontalLayout {
                        padding: MdTokens.space-2;
                        spacing: 12px;

                        Rectangle {
                            width: 12px;
                            background: transparent;
                            Rectangle {
                                y: (parent.height - self.height) / 2;
                                width: 12px;
                                height: 12px;
                                border-radius: MdTokens.shape-full;
                                background: root.error-text != ""
                                    ? MdTokens.on-error-container
                                    : (root.running ? MdTokens.primary : MdTokens.outline-variant);
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            spacing: 3px;
                            Text {
                                text: root.error-text != "" ? "Action failed" : root.state;
                                color: root.error-text != ""
                                    ? MdTokens.on-error-container
                                    : (root.running ? MdTokens.on-primary-container : MdTokens.on-surface);
                                font-size: MdTokens.type-title-medium;
                                font-weight: MdTokens.weight-medium;
                            }
                            Text {
                                text: root.state-detail;
                                color: root.error-text != ""
                                    ? MdTokens.on-error-container
                                    : (root.running ? MdTokens.on-primary-container : MdTokens.on-surface-variant);
                                font-size: MdTokens.type-body-small;
                                overflow: elide;
                            }
                        }

                        Rectangle { horizontal-stretch: 1; }

                        Rectangle {
                            width: 24px;
                            background: transparent;
                            visible: root.busy && root.error-text == "";
                            ProgressIndicator {
                                y: (parent.height - self.height) / 2;
                                width: 24px;
                                height: 24px;
                                indeterminate: true;
                            }
                        }

                        MaterialIconButton {
                            icon-kind: 4;
                            visible: root.error-text != "";
                            field-label: "Show error diagnostics";
                            clicked => { root.open-diagnostics(); }
                        }
                    }

                    animate background { duration: 150ms; easing: ease-in-out; }
                }

                Text {
                    text: "Target screen";
                    height: 20px;
                    color: MdTokens.on-surface-variant;
                    font-size: MdTokens.type-body-medium;
                    font-weight: MdTokens.weight-medium;
                    vertical-alignment: bottom;
                }

                HorizontalLayout {
                    height: MdTokens.target;
                    spacing: MdTokens.space-1;

                    CompactComboBox {
                        horizontal-stretch: 1;
                        height: MdTokens.target;
                        model: root.display-labels;
                        collapsed-model: root.display-names;
                        current-index <=> root.selected-display;
                        control-enabled: !root.running && !root.busy && root.display-labels.length > 0;
                        field-label: "Target screen";
                        popup-width: 352px;
                        selected => { root.display-selected(); }
                    }

                    MaterialIconButton {
                        icon-kind: root.stream-only ? 2 : 3;
                        control-enabled: !root.running && !root.busy;
                        field-label: root.stream-only
                            ? "Configure stream-only screen"
                            : "Configure target screen size";
                        clicked => {
                            if root.stream-only { root.open-stream-config(); }
                            else { root.open-screen-size(); }
                        }
                    }
                }

                VerticalLayout {
                    height: 72px;
                    spacing: 4px;

                    HorizontalLayout {
                        height: 20px;
                        spacing: MdTokens.space-1;

                        Text {
                            text: "Reference display";
                            color: MdTokens.on-surface-variant;
                            font-size: MdTokens.type-body-medium;
                            font-weight: MdTokens.weight-medium;
                            vertical-alignment: bottom;
                        }

                        Text {
                            width: 144px;
                            text: "Sizing";
                            color: MdTokens.on-surface-variant;
                            font-size: MdTokens.type-body-medium;
                            font-weight: MdTokens.weight-medium;
                            vertical-alignment: bottom;
                        }

                        Rectangle {
                            width: MdTokens.target;
                            background: transparent;
                        }
                    }

                    HorizontalLayout {
                        height: MdTokens.target;
                        spacing: MdTokens.space-1;

                        CompactComboBox {
                            horizontal-stretch: 1;
                            height: MdTokens.target;
                            model: root.reference-labels;
                            collapsed-model: root.reference-names;
                            current-index <=> root.selected-reference;
                            control-enabled: !root.running && !root.busy && root.reference-labels.length > 0;
                            field-label: "Reference display";
                            popup-width: 352px;
                            selected => { root.reference-selected(); }
                        }

                        CompactComboBox {
                            width: 144px;
                            height: MdTokens.target;
                            model: [
                                "Physical",
                                "Rounded",
                                "Integer",
                            ];
                            current-index <=> root.sizing-strategy;
                            control-enabled: !root.running && !root.busy;
                            field-label: "Virtual display sizing strategy";
                            selected => { root.strategy-selected(); }
                        }

                        MaterialIconButton {
                            icon-kind: root.reference-manual ? 2 : 5;
                            control-enabled: root.reference-action-enabled
                                && !root.running && !root.busy;
                            field-label: root.reference-manual
                                ? "Configure manual reference display"
                                : "Calculate virtual display geometry";
                            clicked => {
                                if root.reference-manual {
                                    root.open-manual-geometry();
                                } else {
                                    root.calculate-geometry();
                                }
                            }
                        }
                    }
                }

                Rectangle {
                    height: 64px;
                    background: MdTokens.surface-container;
                    border-radius: MdTokens.shape-medium;

                    HorizontalLayout {
                        padding: MdTokens.space-2;
                        spacing: 12px;

                        Rectangle {
                            width: 12px;
                            background: transparent;

                            Rectangle {
                                y: (parent.height - self.height) / 2;
                                width: 12px;
                                height: 12px;
                                border-radius: MdTokens.shape-full;
                                background: root.geometry-configured
                                    ? MdTokens.primary
                                    : MdTokens.outline-variant;
                            }
                        }

                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            spacing: 3px;

                            Text {
                                text: "Virtual display";
                                color: MdTokens.on-surface;
                                font-size: MdTokens.type-title-medium;
                                font-weight: MdTokens.weight-medium;
                            }

                            Text {
                                text: root.stream-only
                                    ? "LAN endpoint"
                                    : (root.geometry-configured
                                        ? "Saved geometry"
                                        : "Using driver default");
                                color: MdTokens.on-surface-variant;
                                font-size: MdTokens.type-body-small;
                                overflow: elide;
                            }
                        }

                        VerticalLayout {
                            width: root.stream-only ? 184px : 144px;
                            alignment: center;
                            spacing: 3px;

                            Text {
                                text: root.geometry-summary;
                                color: MdTokens.on-surface;
                                font-size: MdTokens.type-title-medium;
                                font-weight: MdTokens.weight-medium;
                                horizontal-alignment: right;
                                overflow: elide;
                            }

                            Text {
                                text: root.stream-only
                                    ? (root.sunshine-state == 2 && root.sunshine-port > 0
                                        ? (root.sunshine-lan-ip == "--"
                                            ? "LAN unavailable"
                                            : root.sunshine-lan-ip + ":" + root.sunshine-port)
                                        : (root.sunshine-state == 1
                                            ? "Starting"
                                            : (root.sunshine-state == 3
                                                ? "Unavailable"
                                                : "--")))
                                    : root.geometry-summary-detail;
                                color: root.stream-only && root.sunshine-state == 3
                                    ? MdTokens.error
                                    : (root.stream-only && root.sunshine-state == 2
                                        ? MdTokens.primary
                                        : MdTokens.on-surface-variant);
                                font-size: MdTokens.type-body-small;
                                font-weight: root.stream-only && root.sunshine-state == 2
                                    ? MdTokens.weight-medium
                                    : 400;
                                horizontal-alignment: right;
                                overflow: elide;
                            }
                        }
                    }
                }

                Rectangle { vertical-stretch: 1; }

                if root.stream-only && root.running : Button {
                    height: MdTokens.target;
                    text: root.sunshine-panel-enabled
                        ? "Open Sunshine"
                        : "Waiting for Sunshine";
                    enabled: root.sunshine-panel-enabled && !root.busy;
                    accessible-label: "Open this Sunshine instance's web configuration panel";
                    clicked => { root.open-sunshine-panel(); }
                }

                FullWidthPrimaryButton {
                    text: root.running ? "Stop and restore" : (root.busy ? root.state : "Start mapping");
                    enabled: !root.busy && (root.running || root.selected-display >= 0);
                    accessible-label: root.running ? "Stop mapping and restore windows" : "Start mapping";
                    clicked => {
                        if root.running { root.stop(); } else { root.start(); }
                    }
                }

            }
        }
    }

    if root.screen-size-page : FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.close-screen-size();
                return accept;
            }
            return reject;
        }

        Rectangle {
            width: parent.width;
            height: parent.height;
            background: MdTokens.surface;

            VerticalLayout {
                padding: MdTokens.space-2;
                spacing: MdTokens.space-1;

                HorizontalLayout {
                    height: MdTokens.target;
                    spacing: MdTokens.space-1;
                    BackButton {
                        accessible-label: "Back to mapping group";
                        clicked => { root.close-screen-size(); }
                    }
                    Text {
                        text: "Screen size";
                        color: MdTokens.on-surface;
                        font-size: MdTokens.type-title-large;
                        font-weight: MdTokens.weight-medium;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    height: 92px;
                    background: MdTokens.surface-container;
                    border-radius: MdTokens.shape-medium;
                    VerticalLayout {
                        padding: 12px;
                        spacing: 3px;
                        Text {
                            text: root.screen-size-target;
                            color: MdTokens.on-surface;
                            font-size: MdTokens.type-title-medium;
                            font-weight: MdTokens.weight-medium;
                            overflow: elide;
                        }
                        Text {
                            text: "EDID · " + root.screen-size-detected-mm;
                            color: MdTokens.on-surface-variant;
                            font-size: MdTokens.type-body-medium;
                        }
                        Text {
                            text: root.screen-size-detected-inches + " · " + root.screen-size-native-mode;
                            color: MdTokens.on-surface-variant;
                            font-size: MdTokens.type-body-small;
                            overflow: elide;
                        }
                    }
                }

                Rectangle {
                    height: 136px;
                    background: MdTokens.surface-container;
                    border-radius: MdTokens.shape-medium;
                    VerticalLayout {
                        padding: 12px;
                        spacing: MdTokens.space-1;
                        Text {
                            text: "Manual override";
                            color: MdTokens.on-surface;
                            font-size: MdTokens.type-body-medium;
                            font-weight: MdTokens.weight-medium;
                        }
                        HorizontalLayout {
                            height: MdTokens.target;
                            spacing: MdTokens.space-1;
                            LineEdit {
                                horizontal-stretch: 1;
                                height: MdTokens.target;
                                text <=> root.screen-size-manual-inches;
                                placeholder-text: "Diagonal in";
                                input-type: InputType.decimal;
                                accessible-label: "Target display diagonal in inches";
                                edited => { root.screen-size-edited(); }
                            }
                            CompactComboBox {
                                width: 112px;
                                height: MdTokens.target;
                                model: ["Native", "16:9", "16:10", "3:2", "4:3", "21:9", "32:9"];
                                current-index <=> root.screen-size-aspect-ratio;
                                control-enabled: root.screen-size-manual-inches != "";
                                field-label: "Target display physical aspect ratio";
                                selected => { root.screen-size-edited(); }
                            }
                        }
                        Text {
                            text: "Diagonal and ratio determine the effective dimensions";
                            color: MdTokens.on-surface-variant;
                            font-size: MdTokens.type-body-small;
                            overflow: elide;
                        }
                    }
                }

                Rectangle {
                    height: 72px;
                    background: root.screen-size-error == ""
                        ? MdTokens.primary-container : MdTokens.error-container;
                    border-radius: MdTokens.shape-medium;
                    VerticalLayout {
                        padding: 12px;
                        alignment: center;
                        spacing: 3px;
                        Text {
                            text: root.screen-size-error == ""
                                ? "Effective · " + root.screen-size-effective-mm
                                : "Check the value";
                            color: root.screen-size-error == ""
                                ? MdTokens.on-primary-container : MdTokens.on-error-container;
                            font-size: MdTokens.type-title-medium;
                            font-weight: MdTokens.weight-medium;
                            overflow: elide;
                        }
                        Text {
                            text: root.screen-size-error == ""
                                ? root.screen-size-effective-inches + " · " + root.screen-size-source
                                : root.screen-size-error;
                            color: root.screen-size-error == ""
                                ? MdTokens.on-primary-container : MdTokens.on-error-container;
                            font-size: MdTokens.type-body-small;
                            overflow: elide;
                        }
                    }
                }

                Text {
                    height: 32px;
                    text: "Only virtual-resolution calculations use this value.";
                    color: MdTokens.on-surface-variant;
                    font-size: MdTokens.type-body-small;
                    wrap: word-wrap;
                }

                Rectangle { vertical-stretch: 1; }

                HorizontalLayout {
                    height: MdTokens.target;
                    spacing: MdTokens.space-1;
                    PageActionButton {
                        text: "Reset";
                        enabled: !root.screen-size-save-blocked;
                        accessible-label: "Use detected EDID size";
                        clicked => { root.reset-screen-size(); }
                    }
                    PageActionButton {
                        text: "Re-read";
                        accessible-label: "Read display EDID again";
                        clicked => { root.reread-screen-size(); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    PageActionButton {
                        text: "Save";
                        enabled: root.screen-size-valid && !root.screen-size-save-blocked;
                        primary: true;
                        accessible-label: "Save target display physical size";
                        clicked => { root.save-screen-size(); }
                    }
                }
            }
        }
    }

    if root.stream-page : FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.close-stream-config();
                return accept;
            }
            return reject;
        }

        Rectangle {
            width: parent.width;
            height: parent.height;
            background: MdTokens.surface;

            VerticalLayout {
                padding: MdTokens.space-2;
                spacing: MdTokens.space-1;

                HorizontalLayout {
                    height: MdTokens.target;
                    spacing: MdTokens.space-1;
                    BackButton {
                        accessible-label: "Back to mapping group";
                        clicked => { root.close-stream-config(); }
                    }
                    Text {
                        text: "Streaming screen";
                        color: MdTokens.on-surface;
                        font-size: MdTokens.type-title-large;
                        font-weight: MdTokens.weight-medium;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    height: 260px;
                    background: MdTokens.surface-container;
                    border-radius: MdTokens.shape-medium;

                    VerticalLayout {
                        padding: 12px;
                        spacing: MdTokens.space-1;
                        Text {
                            text: "Screen mode";
                            color: MdTokens.on-surface;
                            font-size: MdTokens.type-body-medium;
                            font-weight: MdTokens.weight-medium;
                        }
                        HorizontalLayout {
                            height: 48px;
                            spacing: MdTokens.space-1;
                            ResolutionLineEdit {
                                text <=> root.stream-width;
                                placeholder-text: "Width px";
                                field-label: "Streaming screen width in pixels";
                                suggestion: root.stream-width-suggestion;
                                suggestion-suffix: root.stream-width-suffix;
                                edited => { root.stream-edited(); }
                            }
                            ResolutionLineEdit {
                                text <=> root.stream-height;
                                placeholder-text: "Height px";
                                field-label: "Streaming screen height in pixels";
                                suggestion: root.stream-height-suggestion;
                                suggestion-suffix: root.stream-height-suffix;
                                edited => { root.stream-edited(); }
                            }
                        }
                        HorizontalLayout {
                            height: 48px;
                            spacing: MdTokens.space-1;
                            LineEdit {
                                text <=> root.stream-diagonal;
                                placeholder-text: "Diagonal in";
                                input-type: InputType.decimal;
                                accessible-label: "Streaming screen diagonal in inches";
                                edited => { root.stream-edited(); }
                            }
                            LineEdit {
                                text <=> root.stream-refresh;
                                placeholder-text: "Refresh Hz";
                                input-type: InputType.decimal;
                                accessible-label: "Streaming screen refresh rate in hertz";
                                edited => { root.stream-edited(); }
                            }
                        }
                        HorizontalLayout {
                            height: 48px;
                            spacing: MdTokens.space-2;
                            Text {
                                width: 132px;
                                text: "Screen ratio";
                                color: MdTokens.on-surface-variant;
                                font-size: MdTokens.type-body-medium;
                                vertical-alignment: center;
                            }
                            CompactComboBox {
                                model: ["16:9", "16:10", "3:2", "4:3", "21:9", "32:9"];
                                current-index <=> root.stream-aspect-ratio-index;
                                field-label: "Streaming screen physical aspect ratio";
                                selected => { root.stream-edited(); }
                            }
                        }
                        HorizontalLayout {
                            height: 48px;
                            spacing: MdTokens.space-2;
                            Text {
                                width: 132px;
                                text: "Direction";
                                color: MdTokens.on-surface-variant;
                                font-size: MdTokens.type-body-medium;
                                vertical-alignment: center;
                            }
                            CompactComboBox {
                                model: [
                                    "Landscape",
                                    "Landscape (flipped)",
                                    "Portrait (clockwise)",
                                    "Portrait (counter-clockwise)",
                                ];
                                current-index <=> root.stream-rotation;
                                field-label: "Streaming screen orientation";
                                selected => { root.stream-edited(); }
                            }
                        }
                    }
                }

                Rectangle {
                    height: 76px;
                    background: root.stream-error == ""
                        ? MdTokens.primary-container : MdTokens.error-container;
                    border-radius: MdTokens.shape-medium;
                    VerticalLayout {
                        padding: 12px;
                        alignment: center;
                        spacing: 3px;
                        Text {
                            text: root.stream-error == ""
                                ? root.stream-result
                                : "Check the values";
                            color: root.stream-error == ""
                                ? MdTokens.on-primary-container : MdTokens.on-error-container;
                            font-size: MdTokens.type-title-medium;
                            font-weight: MdTokens.weight-medium;
                        }
                        Text {
                            text: root.stream-error == ""
                                ? root.stream-result-detail
                                : root.stream-error;
                            color: root.stream-error == ""
                                ? MdTokens.on-primary-container : MdTokens.on-error-container;
                            font-size: MdTokens.type-body-small;
                            wrap: word-wrap;
                        }
                    }
                }

                Rectangle { vertical-stretch: 1; }

                FullWidthPrimaryButton {
                    text: "Save screen";
                    enabled: root.stream-error == "";
                    accessible-label: "Save stream-only screen mode";
                    clicked => { root.save-stream-config(); }
                }
            }
        }
    }

    if root.geometry-page : FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.close-geometry();
                return accept;
            }
            return reject;
        }

        Rectangle {
            width: parent.width;
            height: parent.height;
            background: MdTokens.surface;

            VerticalLayout {
                padding: MdTokens.space-2;
                spacing: MdTokens.space-1;

                HorizontalLayout {
                    height: MdTokens.target;
                    spacing: MdTokens.space-1;

                    BackButton {
                        accessible-label: "Back to quick access";
                        clicked => { root.close-geometry(); }
                    }

                    Text {
                        text: "Manual reference";
                        color: MdTokens.on-surface;
                        font-size: MdTokens.type-title-large;
                        font-weight: MdTokens.weight-medium;
                        vertical-alignment: center;
                    }
                }

                ScrollView {
                    vertical-stretch: 1;

                    VerticalLayout {
                        spacing: 12px;

                        Rectangle {
                            height: 200px;
                            background: MdTokens.surface-container;
                            border-radius: MdTokens.shape-medium;

                            VerticalLayout {
                                padding: 12px;
                                spacing: 4px;

                                Text {
                                    text: "Reference display";
                                    height: 20px;
                                    color: MdTokens.on-surface;
                                    font-size: MdTokens.type-body-medium;
                                    font-weight: MdTokens.weight-medium;
                                }

                                HorizontalLayout {
                                    height: 48px;
                                    spacing: MdTokens.space-1;
                                    ResolutionLineEdit {
                                        text <=> root.reference-width;
                                        placeholder-text: "Width px";
                                        field-label: "Reference display width in pixels";
                                        suggestion: root.reference-width-suggestion;
                                        suggestion-suffix: root.reference-width-suffix;
                                        edited => { root.geometry-edited(); }
                                    }
                                    ResolutionLineEdit {
                                        text <=> root.reference-height;
                                        placeholder-text: "Height px";
                                        field-label: "Reference display height in pixels";
                                        suggestion: root.reference-height-suggestion;
                                        suggestion-suffix: root.reference-height-suffix;
                                        edited => { root.geometry-edited(); }
                                    }
                                }

                                HorizontalLayout {
                                    height: 48px;
                                    spacing: MdTokens.space-1;
                                    LineEdit {
                                        text <=> root.reference-diagonal;
                                        placeholder-text: "Diagonal in";
                                        input-type: InputType.decimal;
                                        accessible-label: "Reference display diagonal in inches";
                                        edited => { root.geometry-edited(); }
                                    }
                                    CompactComboBox {
                                        model: ["16:9", "16:10", "3:2", "4:3", "21:9", "32:9"];
                                        current-index <=> root.reference-aspect-ratio;
                                        field-label: "Reference display physical aspect ratio";
                                        selected => { root.geometry-edited(); }
                                    }
                                }

                                HorizontalLayout {
                                    height: 48px;
                                    spacing: MdTokens.space-1;

                                    CompactComboBox {
                                        model: [
                                            "Landscape",
                                            "Landscape (flipped)",
                                            "Portrait (clockwise)",
                                            "Portrait (counter-clockwise)",
                                        ];
                                        current-index <=> root.reference-rotation;
                                        field-label: "Reference display orientation";
                                        selected => { root.geometry-edited(); }
                                    }

                                    CompactComboBox {
                                        model: [
                                            "Physical",
                                            "Rounded",
                                            "Integer",
                                        ];
                                        current-index <=> root.sizing-strategy;
                                        field-label: "Virtual display sizing strategy";
                                        selected => {
                                            root.strategy-selected();
                                            root.geometry-edited();
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                Rectangle {
                    height: root.geometry-error == "" ? 64px : 84px;
                    background: root.geometry-error == ""
                        ? MdTokens.primary-container
                        : MdTokens.error-container;
                    border-radius: MdTokens.shape-medium;

                    VerticalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        alignment: center;
                        spacing: 2px;

                        Text {
                            text: root.geometry-result;
                            color: root.geometry-error == ""
                                ? MdTokens.on-primary-container
                                : MdTokens.on-error-container;
                            font-size: MdTokens.type-title-medium;
                            font-weight: MdTokens.weight-medium;
                        }
                        Text {
                            text: root.geometry-error == ""
                                ? root.geometry-result-detail
                                : root.geometry-error;
                            color: root.geometry-error == ""
                                ? MdTokens.on-primary-container
                                : MdTokens.on-error-container;
                            font-size: MdTokens.type-body-small;
                            wrap: word-wrap;
                        }
                    }
                }

                FullWidthPrimaryButton {
                    text: root.stream-only ? "Save reference" : "Save plan";
                    enabled: root.geometry-valid && !root.geometry-save-blocked;
                    accessible-label: root.stream-only
                        ? "Save manual streaming reference display"
                        : "Save planned virtual display geometry";
                    clicked => { root.save-geometry(); }
                }
            }
        }
    }

    if root.diagnostics-page : FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.close-diagnostics();
                return accept;
            }
            return reject;
        }

        Rectangle {
            width: parent.width;
            height: parent.height;
            background: MdTokens.surface;

            VerticalLayout {
                padding: MdTokens.space-2;
                spacing: MdTokens.space-1;

                HorizontalLayout {
                    height: MdTokens.target;
                    spacing: MdTokens.space-1;

                    BackButton {
                        accessible-label: "Back to quick access";
                        clicked => { root.close-diagnostics(); }
                    }

                    Text {
                        text: "Diagnostics";
                        color: MdTokens.on-surface;
                        font-size: MdTokens.type-title-large;
                        font-weight: MdTokens.weight-medium;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    height: 88px;
                    background: MdTokens.error-container;
                    border-radius: MdTokens.shape-medium;

                    VerticalLayout {
                        padding: 12px;
                        spacing: 4px;

                        Text {
                            text: "Last error";
                            color: MdTokens.on-error-container;
                            font-size: MdTokens.type-title-medium;
                            font-weight: MdTokens.weight-medium;
                        }

                        Text {
                            text: root.diagnostic-summary;
                            color: MdTokens.on-error-container;
                            font-size: MdTokens.type-body-small;
                            wrap: word-wrap;
                            overflow: clip;
                        }
                    }
                }

                HorizontalLayout {
                    height: 24px;
                    spacing: MdTokens.space-1;

                    Text {
                        horizontal-stretch: 1;
                        text: "Recent activity";
                        color: MdTokens.on-surface;
                        font-size: MdTokens.type-body-medium;
                        font-weight: MdTokens.weight-medium;
                        vertical-alignment: center;
                    }

                    Text {
                        width: 176px;
                        text: root.diagnostic-path;
                        color: MdTokens.on-surface-variant;
                        font-size: MdTokens.type-body-small;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                        overflow: elide;
                        accessible-label: "Log file " + root.diagnostic-path;
                    }
                }

                TextEdit {
                    vertical-stretch: 1;
                    text: root.diagnostic-text;
                    read-only: true;
                    font-size: MdTokens.type-body-small;
                    font-family: "Cascadia Mono";
                    wrap: word-wrap;
                    accessible-label: "Recent diagnostic records. Text can be selected and copied.";
                }

                Text {
                    height: root.diagnostic-action-error == "" ? 0px : 18px;
                    visible: root.diagnostic-action-error != "";
                    text: root.diagnostic-action-error;
                    color: MdTokens.error;
                    font-size: MdTokens.type-body-small;
                    overflow: elide;
                }

                FullWidthPrimaryButton {
                    text: "Open log folder";
                    accessible-label: "Open the SBMS diagnostic log folder";
                    clicked => { root.open-log-folder(); }
                }
            }
        }
    }

    if root.pending-remove-index >= 0 : FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.pending-remove-index = -1;
                return accept;
            }
            return reject;
        }

        Rectangle {
            width: parent.width;
            height: parent.height;
            background: #66000000;

            TouchArea {
                accessible-role: none;
                clicked => { root.pending-remove-index = -1; }
            }

            dialog := Rectangle {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 320px;
                height: 184px;
                background: MdTokens.surface;
                border-width: 1px;
                border-color: MdTokens.outline-variant;
                border-radius: 28px;

                TouchArea {
                    accessible-role: none;
                }

                VerticalLayout {
                    padding: 20px;
                    spacing: MdTokens.space-1;

                    Text {
                        height: 28px;
                        text: "Remove mapping group?";
                        color: MdTokens.on-surface;
                        font-size: MdTokens.type-title-large;
                        font-weight: MdTokens.weight-medium;
                        vertical-alignment: center;
                    }

                    Text {
                        height: 52px;
                        text: "Its target, sizing and stream settings will be discarded.";
                        color: MdTokens.on-surface-variant;
                        font-size: MdTokens.type-body-medium;
                        wrap: word-wrap;
                    }

                    HorizontalLayout {
                        height: MdTokens.target;
                        spacing: MdTokens.space-1;
                        Rectangle { horizontal-stretch: 1; }
                        DialogActionButton {
                            text: "Cancel";
                            field-label: "Cancel removing mapping group";
                            clicked => { root.pending-remove-index = -1; }
                        }
                        DialogActionButton {
                            text: "Remove";
                            field-label: "Confirm removing mapping group";
                            destructive: true;
                            clicked => {
                                root.remove-group(root.pending-remove-index);
                                root.pending-remove-index = -1;
                            }
                        }
                    }
                }
            }
        }
    }
}
