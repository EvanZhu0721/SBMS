import { MainPage } from "pages/main.slint";
import { ScreenSizePage } from "pages/screen-size.slint";
import { StreamPage } from "pages/stream.slint";
import { GeometryPage } from "pages/geometry.slint";
import { DiagnosticsPage } from "pages/diagnostics.slint";
import { RemoveGroupDialog } from "remove-group-dialog.slint";
import { LaunchIntro } from "launch-intro.slint";
import { MdTokens } from "theme.slint";

export enum QuickAccessPage {
    main,
    screen-size,
    stream,
    geometry,
    diagnostics,
}

export component QuickAccess inherits Window {
    title: "SBMS Quick Access";
    width: 384px;
    height: 544px;
    background: MdTokens.surface;
    always-on-top: true;
    no-frame: true;

    in-out property <QuickAccessPage> page: QuickAccessPage.main;
    in-out property <bool> intro-active: false;
    in-out property <int> intro-stage: 0;
    in-out property <[string]> display-names;
    in-out property <[string]> display-labels;
    in-out property <[string]> display-ids;
    in-out property <int> selected-display: -1;
    in property <bool> stream-only: false;
    in-out property <[string]> tab-labels;
    in-out property <[string]> tab-details;
    in-out property <[int]> tab-indices;
    in property <int> active-group-index: 0;
    in property <int> group-count: 1;
    in property <int> max-group-count: 1;
    in-out property <int> pending-remove-index: -1;
    in-out property <[string]> reference-names;
    in-out property <[string]> reference-labels;
    in-out property <[string]> reference-ids;
    in-out property <int> selected-reference: -1;
    in property <bool> reference-manual: false;
    in property <bool> reference-action-enabled: false;
    in-out property <int> sizing-strategy: 0;
    in property <string> state: "Stopped";
    in property <string> state-detail: "Choose a target screen to begin";
    in property <bool> running: false;
    in property <bool> busy: false;
    in property <bool> restart-available: false;
    in property <string> error-text: "";
    in property <int> mapping-fps: 0;
    in property <bool> mapping-fps-valid: false;
    in property <bool> mapping-fps-error: false;
    in property <bool> mapping-fps-nan: false;
    in property <string> screen-size-target: "";
    in property <string> screen-size-native-mode: "";
    in property <string> screen-size-detected-mm: "Not reported";
    in property <string> screen-size-detected-inches: "";
    in-out property <string> screen-size-manual-inches: "";
    in-out property <int> screen-size-aspect-ratio: 0;
    in property <string> screen-size-effective-mm: "";
    in property <string> screen-size-effective-inches: "";
    in property <string> screen-size-source: "";
    in property <string> screen-size-error: "";
    in property <bool> screen-size-valid: true;
    in property <bool> screen-size-save-blocked: false;
    in property <string> diagnostic-summary: "";
    in property <string> diagnostic-text: "No diagnostic records are available.";
    in property <string> diagnostic-path: "";
    in property <string> diagnostic-action-error: "";
    in property <bool> geometry-valid: false;
    in property <bool> geometry-save-blocked: false;
    in property <bool> geometry-configured: false;
    in property <string> geometry-summary: "3840 × 2160";
    in property <string> geometry-summary-detail: "Driver · 240 Hz";
    in property <string> geometry-result: "Enter display measurements";
    in property <string> geometry-result-detail: "All values use pixels or millimetres";
    in property <string> geometry-error: "";
    in-out property <string> reference-width: "";
    in-out property <string> reference-height: "";
    in-out property <string> reference-diagonal: "";
    in-out property <int> reference-aspect-ratio: 0;
    in-out property <int> reference-rotation: 0;
    in property <string> reference-width-suggestion: "";
    in property <string> reference-width-suffix: "";
    in property <string> reference-height-suggestion: "";
    in property <string> reference-height-suffix: "";
    in-out property <string> stream-width: "3840";
    in-out property <string> stream-height: "2160";
    in-out property <string> stream-diagonal: "";
    in-out property <string> stream-refresh: "60";
    in-out property <int> stream-aspect-ratio-index: 1;
    in-out property <int> stream-rotation: 0;
    in property <string> stream-width-suggestion: "";
    in property <string> stream-width-suffix: "";
    in property <string> stream-height-suggestion: "";
    in property <string> stream-height-suffix: "";
    in property <string> stream-aspect-ratio: "";
    in property <string> stream-result: "Configure the streaming screen";
    in property <string> stream-result-detail: "Reference geometry determines the virtual mode";
    in property <string> stream-error: "";
    in property <bool> sunshine-panel-enabled: false;
    in property <int> sunshine-state: 0;
    in property <int> sunshine-port: 0;
    in property <string> sunshine-lan-ip: "--";

    callback start();
    callback stop();
    callback restart-mapping();
    callback display-selected();
    callback reference-selected();
    callback strategy-selected();
    callback calculate-geometry();
    callback open-manual-geometry();
    callback dismiss();
    callback close-geometry();
    callback geometry-edited();
    callback save-geometry();
    callback open-diagnostics();
    callback close-diagnostics();
    callback open-log-folder();
    callback tab-selected(int);
    callback tab-wheel(int);
    callback add-group();
    callback remove-group(int);
    callback open-stream-config();
    callback close-stream-config();
    callback stream-edited();
    callback save-stream-config();
    callback open-sunshine-panel();
    callback open-display-settings();
    callback disable-launch-intro();
    callback open-project-home();
    callback open-screen-size();
    callback close-screen-size();
    callback screen-size-edited();
    callback reset-screen-size();
    callback reread-screen-size();
    callback save-screen-size();

    if root.page == QuickAccessPage.main : MainPage {
        width: parent.width;
        height: parent.height;
        display-names: root.display-names;
        display-labels: root.display-labels;
        display-ids: root.display-ids;
        selected-display <=> root.selected-display;
        stream-only: root.stream-only;
        tab-labels: root.tab-labels;
        tab-details: root.tab-details;
        tab-indices: root.tab-indices;
        active-group-index: root.active-group-index;
        group-count: root.group-count;
        max-group-count: root.max-group-count;
        pending-remove-index <=> root.pending-remove-index;
        reference-names: root.reference-names;
        reference-labels: root.reference-labels;
        reference-ids: root.reference-ids;
        selected-reference <=> root.selected-reference;
        reference-manual: root.reference-manual;
        reference-action-enabled: root.reference-action-enabled;
        sizing-strategy <=> root.sizing-strategy;
        state: root.state;
        state-detail: root.state-detail;
        running: root.running;
        busy: root.busy;
        restart-available: root.restart-available;
        error-text: root.error-text;
        mapping-fps: root.mapping-fps;
        mapping-fps-valid: root.mapping-fps-valid;
        mapping-fps-error: root.mapping-fps-error;
        mapping-fps-nan: root.mapping-fps-nan;
        geometry-configured: root.geometry-configured;
        geometry-summary: root.geometry-summary;
        geometry-summary-detail: root.geometry-summary-detail;
        sunshine-panel-enabled: root.sunshine-panel-enabled;
        sunshine-state: root.sunshine-state;
        sunshine-port: root.sunshine-port;
        sunshine-lan-ip: root.sunshine-lan-ip;

        start => { root.start(); }
        stop => { root.stop(); }
        restart-mapping => { root.restart-mapping(); }
        display-selected => { root.display-selected(); }
        reference-selected => { root.reference-selected(); }
        strategy-selected => { root.strategy-selected(); }
        calculate-geometry => { root.calculate-geometry(); }
        open-manual-geometry => { root.open-manual-geometry(); }
        dismiss => { root.dismiss(); }
        open-diagnostics => { root.open-diagnostics(); }
        tab-selected(index) => { root.tab-selected(index); }
        tab-wheel(delta) => { root.tab-wheel(delta); }
        add-group => { root.add-group(); }
        open-stream-config => { root.open-stream-config(); }
        open-sunshine-panel => { root.open-sunshine-panel(); }
        open-display-settings => { root.open-display-settings(); }
        open-screen-size => { root.open-screen-size(); }
    }

    if root.page == QuickAccessPage.screen-size : ScreenSizePage {
        width: parent.width;
        height: parent.height;
        screen-size-target: root.screen-size-target;
        screen-size-native-mode: root.screen-size-native-mode;
        screen-size-detected-mm: root.screen-size-detected-mm;
        screen-size-detected-inches: root.screen-size-detected-inches;
        screen-size-manual-inches <=> root.screen-size-manual-inches;
        screen-size-aspect-ratio <=> root.screen-size-aspect-ratio;
        screen-size-effective-mm: root.screen-size-effective-mm;
        screen-size-effective-inches: root.screen-size-effective-inches;
        screen-size-source: root.screen-size-source;
        screen-size-error: root.screen-size-error;
        screen-size-valid: root.screen-size-valid;
        screen-size-save-blocked: root.screen-size-save-blocked;

        close-screen-size => { root.close-screen-size(); }
        screen-size-edited => { root.screen-size-edited(); }
        reset-screen-size => { root.reset-screen-size(); }
        reread-screen-size => { root.reread-screen-size(); }
        save-screen-size => { root.save-screen-size(); }
    }

    if root.page == QuickAccessPage.stream : StreamPage {
        width: parent.width;
        height: parent.height;
        stream-width <=> root.stream-width;
        stream-height <=> root.stream-height;
        stream-diagonal <=> root.stream-diagonal;
        stream-refresh <=> root.stream-refresh;
        stream-aspect-ratio-index <=> root.stream-aspect-ratio-index;
        stream-rotation <=> root.stream-rotation;
        stream-width-suggestion: root.stream-width-suggestion;
        stream-width-suffix: root.stream-width-suffix;
        stream-height-suggestion: root.stream-height-suggestion;
        stream-height-suffix: root.stream-height-suffix;
        stream-aspect-ratio: root.stream-aspect-ratio;
        stream-result: root.stream-result;
        stream-result-detail: root.stream-result-detail;
        stream-error: root.stream-error;

        close-stream-config => { root.close-stream-config(); }
        stream-edited => { root.stream-edited(); }
        save-stream-config => { root.save-stream-config(); }
    }

    if root.page == QuickAccessPage.geometry : GeometryPage {
        width: parent.width;
        height: parent.height;
        stream-only: root.stream-only;
        geometry-valid: root.geometry-valid;
        geometry-save-blocked: root.geometry-save-blocked;
        geometry-result: root.geometry-result;
        geometry-result-detail: root.geometry-result-detail;
        geometry-error: root.geometry-error;
        reference-width <=> root.reference-width;
        reference-height <=> root.reference-height;
        reference-diagonal <=> root.reference-diagonal;
        reference-aspect-ratio <=> root.reference-aspect-ratio;
        reference-rotation <=> root.reference-rotation;
        reference-width-suggestion: root.reference-width-suggestion;
        reference-width-suffix: root.reference-width-suffix;
        reference-height-suggestion: root.reference-height-suggestion;
        reference-height-suffix: root.reference-height-suffix;
        sizing-strategy <=> root.sizing-strategy;

        close-geometry => { root.close-geometry(); }
        geometry-edited => { root.geometry-edited(); }
        strategy-selected => { root.strategy-selected(); }
        save-geometry => { root.save-geometry(); }
    }

    if root.page == QuickAccessPage.diagnostics : DiagnosticsPage {
        width: parent.width;
        height: parent.height;
        diagnostic-summary: root.diagnostic-summary;
        diagnostic-text: root.diagnostic-text;
        diagnostic-path: root.diagnostic-path;
        diagnostic-action-error: root.diagnostic-action-error;

        close-diagnostics => { root.close-diagnostics(); }
        open-log-folder => { root.open-log-folder(); }
    }

    if root.pending-remove-index >= 0 : RemoveGroupDialog {
        width: parent.width;
        height: parent.height;
        pending-remove-index <=> root.pending-remove-index;
        remove-group(index) => { root.remove-group(index); }
    }

    LaunchIntro {
        width: parent.width;
        height: parent.height;
        active: root.intro-active;
        stage: root.intro-stage;
        disable-forever => { root.disable-launch-intro(); }
        open-project-home => { root.open-project-home(); }
    }
}
