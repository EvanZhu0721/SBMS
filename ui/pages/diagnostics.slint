import { ScrollView } from "std-widgets.slint";
import { BackButton, FullWidthPrimaryButton } from "../controls.slint";
import { MdTokens } from "../theme.slint";

export component DiagnosticsPage inherits FocusScope {
    in property <string> diagnostic-summary: "";
    in property <string> diagnostic-text: "No diagnostic records are available.";
    in property <string> diagnostic-path: "";
    in property <string> diagnostic-action-error: "";
    
    callback close-diagnostics();
    callback open-log-folder();

            key-pressed(event) => {
                if event.text == Key.Escape {
                    root.close-diagnostics();
                    return accept;
                }
                return reject;
            }
    
            Rectangle {
                width: parent.width;
                height: parent.height;
                background: MdTokens.surface;
    
                VerticalLayout {
                    padding: MdTokens.space-2;
                    spacing: MdTokens.space-1;
    
                    HorizontalLayout {
                        height: MdTokens.target;
                        spacing: MdTokens.space-1;
    
                        BackButton {
                            accessible-label: "Back to quick access";
                            clicked => { root.close-diagnostics(); }
                        }
    
                        Text {
                            text: "Diagnostics";
                            color: MdTokens.on-surface;
                            font-size: MdTokens.type-title-large;
                            font-weight: MdTokens.weight-medium;
                            vertical-alignment: center;
                        }
                    }
    
                    if root.diagnostic-summary != "" : Rectangle {
                        height: 88px;
                        background: MdTokens.error-container;
                        border-radius: MdTokens.shape-medium;
    
                        VerticalLayout {
                            padding: 12px;
                            spacing: 4px;
    
                            Text {
                                text: "Last recorded error";
                                color: MdTokens.on-error-container;
                                font-size: MdTokens.type-title-medium;
                                font-weight: MdTokens.weight-medium;
                            }
    
                            TextInput {
                                text: root.diagnostic-summary;
                                read-only: true;
                                single-line: false;
                                wrap: word-wrap;
                                color: MdTokens.on-error-container;
                                selection-background-color: MdTokens.on-error-container;
                                selection-foreground-color: MdTokens.error-container;
                                font-size: MdTokens.type-body-small;
                            }
                        }
                    }
    
                    HorizontalLayout {
                        height: 24px;
                        spacing: MdTokens.space-1;
    
                        Text {
                            horizontal-stretch: 1;
                            text: "Recent activity";
                            color: MdTokens.on-surface;
                            font-size: MdTokens.type-body-medium;
                            font-weight: MdTokens.weight-medium;
                            vertical-alignment: center;
                        }
    
                        Text {
                            width: 176px;
                            text: root.diagnostic-path;
                            color: MdTokens.on-surface-variant;
                            font-size: MdTokens.type-body-small;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                            overflow: elide;
                            accessible-label: "Log file " + root.diagnostic-path;
                        }
                    }
    
                    Rectangle {
                        vertical-stretch: 1;
                        background: MdTokens.surface-container;
                        border-radius: 4px;
                        border-width: 1px;
                        border-color: log-input.has-focus ? MdTokens.primary : MdTokens.outline-variant;
                        clip: true;

                        ContextMenuArea {
                            Menu {
                                MenuItem {
                                    title: "Copy";
                                    activated => { log-input.copy(); }
                                }
                                MenuItem {
                                    title: "Select All";
                                    activated => { log-input.select-all(); }
                                }
                            }

                            log-scroll := ScrollView {
                                // Drag selects text; the wheel and scrollbar still scroll.
                                mouse-drag-pan-enabled: false;
                                viewport-width: self.visible-width;
                                viewport-height: max(self.visible-height, log-input.preferred-height + 16px);

                                log-input := TextInput {
                                    x: 8px;
                                    y: 8px;
                                    width: log-scroll.visible-width - 16px;
                                    text: root.diagnostic-text;
                                    read-only: true;
                                    single-line: false;
                                    wrap: word-wrap;
                                    page-height: log-scroll.visible-height;
                                    font-size: MdTokens.type-body-small;
                                    font-family: "Cascadia Mono";
                                    color: MdTokens.on-surface;
                                    selection-background-color: MdTokens.primary-container;
                                    selection-foreground-color: MdTokens.on-primary-container;
                                    accessible-label: "Recent diagnostic records. Text can be selected and copied.";

                                    cursor-position-changed(cpos) => {
                                        if (cpos.y + self.y + log-scroll.viewport-y < 0px) {
                                            log-scroll.viewport-y = min(
                                                0px,
                                                max(log-scroll.visible-height - log-scroll.viewport-height, -(cpos.y + self.y)),
                                            );
                                        } else if (cpos.y + self.y + log-scroll.viewport-y > log-scroll.visible-height - 20px) {
                                            log-scroll.viewport-y = min(
                                                0px,
                                                max(log-scroll.visible-height - log-scroll.viewport-height, log-scroll.visible-height - (cpos.y + self.y) - 20px),
                                            );
                                        }
                                    }
                                }
                            }
                        }
                    }
    
                    Text {
                        height: root.diagnostic-action-error == "" ? 0px : 18px;
                        visible: root.diagnostic-action-error != "";
                        text: root.diagnostic-action-error;
                        color: MdTokens.error;
                        font-size: MdTokens.type-body-small;
                        overflow: elide;
                    }
    
                    FullWidthPrimaryButton {
                        text: "Open log folder";
                        accessible-label: "Open the SBMS diagnostic log folder";
                        clicked => { root.open-log-folder(); }
                    }
                }
            }
}
