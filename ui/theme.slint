import { Palette } from "std-widgets.slint";

// Stable Material 3 semantic roles. The platform palette selects only the
// light/dark scheme; every SBMS semantic brush is fixed so Windows accent-color
// refreshes cannot change the application's colors after startup.
export global MdTokens {
    private property <bool> dark-color-scheme: Palette.color-scheme == ColorScheme.dark;

    out property <brush> surface: dark-color-scheme ? #2a282d : #f8f3f9;
    out property <brush> on-surface: dark-color-scheme ? #e6e1e5 : #1c1b1f;
    out property <brush> surface-container: dark-color-scheme ? #1c1b1f : #fffbfe;
    out property <brush> on-surface-variant: dark-color-scheme ? #e6e1e5 : #1c1b1f;
    out property <brush> primary: dark-color-scheme ? #cacaca : #343236;
    out property <brush> on-primary: dark-color-scheme ? #343236 : #ffffff;
    out property <brush> primary-container: dark-color-scheme ? #4f378b : #eaddff;
    out property <brush> on-primary-container: dark-color-scheme ? #eaddff : #21005d;
    out property <brush> error: dark-color-scheme ? #ffb4ab : #ba1a1a;
    out property <brush> error-container: dark-color-scheme ? #93000a : #ffdad6;
    out property <brush> on-error-container: dark-color-scheme ? #ffdad6 : #410002;
    out property <brush> success-container: dark-color-scheme ? #173824 : #d5f5df;
    out property <brush> on-success-container: dark-color-scheme ? #8fdaa5 : #155c2d;
    out property <brush> outline-variant: dark-color-scheme ? #938f99 : #79747e;

    out property <length> space-1: 8px;
    out property <length> space-2: 16px;
    out property <length> shape-medium: 12px;
    out property <length> shape-large: 16px;
    out property <length> shape-full: 999px;
    out property <length> button-radius: 20px;
    out property <length> target: 48px;
    out property <length> type-title-large: 22px;
    out property <length> type-title-medium: 16px;
    out property <length> type-body-large: 16px;
    out property <length> type-body-medium: 14px;
    out property <length> type-body-small: 12px;
    out property <int> weight-medium: 500;
}
